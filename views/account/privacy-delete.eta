<% layout('./layout') %>
<div class="page-head">
  <a class="back" href="/account/privacy"><img src="<%= asset('icons/arrow-left.svg') %>" alt="" width="18" height="18">Data &amp; privacy</a>
  <h1 id="title">Delete your <%= it.providerName %> account?</h1>
</div>
<section class="panel pad confirm-panel" aria-labelledby="title">
  <img src="<%= asset('icons/status-delete.svg') %>" alt="" width="64" height="64">
  <p>You’ll be signed out of every app that uses <%= it.providerName %>. Your account is deleted after <%= it.graceDays %> days. Sign in before then to cancel.</p>
  <form class="actions" method="post" action="/account/privacy/delete">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
    <a class="btn ghost" href="/account/privacy">Cancel</a>
    <button type="submit" class="btn danger">Delete account</button>
  </form>
</section>
