<% layout('./layout') %>
<h1 id="title">Password</h1>
<p class="lede"><%= it.profile.passwordSetAt ? 'Choose a new password. Every other device signed in to your account will be signed out; this one stays signed in.' : (it.profile.upstreams.length ? 'Your account signs in with ' + (it.profile.upstreams.indexOf('oauth_google') >= 0 ? 'Google' : 'Apple') + '.' : 'Your account signs in with a code.') + ' Set a password to sign in with it too.' %></p>
<section class="panel" aria-labelledby="h-new">
  <h2 id="h-new"><%= it.profile.passwordSetAt ? 'Change password' : 'Set a password' %></h2>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
    <input type="text" autocomplete="username" value="<%= it.who %>" hidden readonly>
<%~ include('../_new-password', { label: 'New password', confirmLabel: 'Confirm new password', rules: it.rules, checked: it.checked, error: it.error }) %>
    <button type="submit" class="btn"><%= it.profile.passwordSetAt ? 'Change password' : 'Set password' %></button>
  </form>
</section>
