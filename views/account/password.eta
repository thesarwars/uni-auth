<% layout('./layout') %>
<div class="page-head">
  <a class="back" href="/account/security"><img src="/assets/icons/arrow-left.svg" alt="" width="18" height="18">Security &amp; sign-in</a>
  <h1 id="title">Password</h1>
  <p><%= it.profile.passwordSetAt ? 'Choose a strong password you don’t use anywhere else.' : (it.profile.upstreams.length ? 'Your account signs in with ' + (it.profile.upstreams.indexOf('oauth_google') >= 0 ? 'Google' : 'Apple') + '.' : 'Your account signs in with a code.') + ' Set a password to sign in with it too.' %></p>
</div>
<section class="panel pad" aria-label="<%= it.profile.passwordSetAt ? 'Change password' : 'Set a password' %>">
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
    <input type="text" autocomplete="username" value="<%= it.who %>" hidden readonly>
<%~ include('../_new-password', { label: 'New password', confirmLabel: 'Confirm new password', rules: it.rules, checked: it.checked, error: it.error }) %>
<% if (it.profile.passwordSetAt) { %>
    <p class="notice">Changing your password signs you out of every other device.</p>
<% } %>
    <div class="actions">
      <button type="submit" class="btn"><%= it.profile.passwordSetAt ? 'Change password' : 'Set password' %></button>
    </div>
  </form>
</section>
