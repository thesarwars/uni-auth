<% layout('./layout') %>
<div class="page-head">
  <a class="back" href="/account/security"><img src="<%= asset('icons/arrow-left.svg') %>" alt="" width="18" height="18">Security &amp; sign-in</a>
  <h1 id="title">Security activity</h1>
  <p>Sign-ins and changes to your account.</p>
</div>
<section class="panel" aria-labelledby="h-days">
  <div class="panel-head"><h2 id="h-days">Last <%= it.days %> days</h2></div>
  <ul class="rows">
<% if (!it.activity.length) { %>
    <li class="row"><span class="text"><span class="s">Nothing in the last <%= it.days %> days.</span></span></li>
<% } %>
<% it.activity.forEach(function (a) { %>
    <li class="row">
      <span class="tile"><img src="<%= asset('icons/' + a.icon + '.svg') %>" alt="" width="20" height="20"></span>
      <span class="text"><span class="t"><%= a.title %></span><span class="s"><%= a.detail %></span></span>
    </li>
<% }) %>
  </ul>
</section>
<section class="panel" aria-label="Don’t recognise something?">
  <ul class="rows">
    <li class="row first">
      <span class="tile"><img src="<%= asset('icons/alert-circle.svg') %>" alt="" width="20" height="20"></span>
      <span class="text"><span class="t">Don’t recognise something?</span><span class="s">Change your password and sign out on every other device.</span></span>
      <a class="btn stroke small" href="/account/password">Wasn’t me</a>
    </li>
  </ul>
</section>
