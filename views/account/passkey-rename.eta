<% layout('./layout') %>
<div class="page-head">
  <a class="back" href="/account/passkeys"><img src="<%= asset('icons/arrow-left.svg') %>" alt="" width="18" height="18">Passkeys</a>
  <h1 id="title">Rename passkey</h1>
</div>
<section class="panel pad" aria-label="Rename passkey">
  <form method="post" action="/account/passkeys/rename">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
    <input type="hidden" name="id" value="<%= it.id %>">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" class="text" name="name" type="text" autocomplete="off" maxlength="60" required autofocus value="<%= it.name %>"<% if (it.error) { %> aria-invalid="true" aria-describedby="name-error"<% } %>>
<% if (it.error) { %>
      <p id="name-error" class="error" role="alert"><%~ include('../_alert-icon') %><span><%= it.error %></span></p>
<% } else { %>
      <p class="hint">So you can tell your passkeys apart, like “Work laptop” or “YubiKey”.</p>
<% } %>
    </div>
    <div class="actions">
      <a class="btn ghost" href="/account/passkeys">Cancel</a>
      <button type="submit" class="btn">Save</button>
    </div>
  </form>
</section>
