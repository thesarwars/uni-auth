<% layout('./layout') %>
<% var day = function (d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' }); }; %>
<div class="page-head">
  <a class="back" href="/account/apps"><img src="<%= asset('icons/arrow-left.svg') %>" alt="" width="18" height="18">Linked apps</a>
  <h1 id="title"><%= it.app.name %></h1>
</div>
<section class="panel" aria-labelledby="h-access">
  <div class="panel-head">
    <h2 id="h-access">What it can do</h2>
    <p>Signed in since <%= day(it.app.since) %>.</p>
  </div>
  <ul class="rows">
<% it.access.forEach(function (line) { %>
    <li class="row"><span class="text"><span class="t"><%= line %></span></span></li>
<% }) %>
  </ul>
</section>
<section class="panel" aria-label="Remove access">
  <ul class="rows">
    <li class="row first">
      <span class="tile"><img src="<%= asset('icons/logout.svg') %>" alt="" width="20" height="20"></span>
      <span class="text"><span class="t">Remove access</span><span class="s">Signs you out of <%= it.app.name %>. It asks you to sign in again next time.</span></span>
      <form class="do" method="post" action="/account/apps/remove">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <input type="hidden" name="id" value="<%= it.app.key %>">
        <button type="submit" class="btn stroke small">Remove<span class="sr"> access for <%= it.app.name %></span></button>
      </form>
    </li>
  </ul>
</section>
