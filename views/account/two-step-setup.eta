<% layout('./layout') %>
<div class="page-head">
  <a class="back" href="/account/security"><img src="<%= asset('icons/arrow-left.svg') %>" alt="" width="18" height="18">Security &amp; sign-in</a>
  <h1 id="title">Set up an authenticator app</h1>
</div>
<section class="panel pad" aria-labelledby="title">
  <div class="setup">
    <div class="qr" role="img" aria-label="QR code for your authenticator app"><%~ it.qr %></div>
    <div class="setup-steps">
      <p>1. Open your authenticator app and scan this code.</p>
      <p>2. Can’t scan it? Enter this key instead.</p>
      <div class="key">
        <span id="setup-key" class="key-text" aria-label="Setup key"><%= it.key %></span>
        <button type="button" class="copy" data-copy="setup-key" aria-label="Copy setup key" hidden><img src="<%= asset('icons/copy-18.svg') %>" alt="" width="18" height="18"></button>
        <span class="sr" role="status" data-copied></span>
      </div>
      <p id="h-code">3. Enter the 6-digit code the app shows.</p>
      <form id="verify" method="post" action="/account/two-step/setup">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <div class="code"<% if (it.error) { %> data-invalid<% } %>>
          <label for="code" class="sr">6-digit code</label>
          <input id="code" class="text" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" data-length="6" required<% if (it.error) { %> autofocus aria-invalid="true" aria-describedby="code-error"<% } %>>
<% if (it.error) { %>
          <p id="code-error" class="error" role="alert"><%~ include('../_alert-icon') %><span><%= it.error %></span></p>
<% } %>
        </div>
      </form>
    </div>
  </div>
  <div class="actions">
    <a class="btn ghost" href="/account/two-step">Cancel</a>
    <button type="submit" form="verify" class="btn">Verify and turn on</button>
  </div>
</section>
