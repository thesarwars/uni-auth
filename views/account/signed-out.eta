<% layout('./layout') %>
<div class="intro">
  <img class="logo" src="/assets/entity-auth.svg" alt="<%= it.providerName %>" width="44" height="44">
  <h1 id="title"><%= it.heading %></h1>
</div>
<div class="form">
  <p class="text-block"><%= it.detail %></p>
  <div class="actions">
    <a class="btn" href="/account/sign-in">Sign in to your account</a>
  </div>
</div>
