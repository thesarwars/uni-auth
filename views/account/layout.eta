<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %> · <%= it.providerName %> Account</title>
  <link rel="icon" type="image/svg+xml" href="/assets/entity-auth.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/entity-auth-32.png">
  <link rel="apple-touch-icon" href="/assets/entity-auth-180.png">
  <link rel="preload" href="/assets/geist.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/entity-auth.css">
</head>
<body>
<% if (it.nav) { %>
<div class="acct">
  <header class="acct-top">
    <a class="acct-brand" href="/account">
      <span class="name"><img src="/assets/entity-auth.svg" alt="" width="32" height="32"><%= it.providerName %></span>
      <span class="area">Account</span>
    </a>
    <div class="acct-tools">
<% if (it.help) { %>
      <a class="help" href="<%= it.help %>"><img src="/assets/icons/help.svg" alt="Help" width="22" height="22"></a>
<% } %>
      <details class="me">
        <summary aria-label="Your account: <%= it.name || it.who %>"><span class="avatar-i" aria-hidden="true"><%= it.initials %></span></summary>
        <div class="menu">
          <div class="id">
<% if (it.name) { %>            <span class="n"><%= it.name %></span>
<% } %>
            <span class="e"><%= it.who %></span>
          </div>
          <form method="post" action="/account/sign-out">
            <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
            <button type="submit" class="btn stroke small wide">Sign out</button>
          </form>
        </div>
      </details>
    </div>
  </header>
  <div class="acct-body">
    <nav class="acct-nav" aria-label="Account">
      <ul>
<% [['home', '/account', 'Home', 'home'], ['personal', '/account/personal', 'Personal info', 'user'], ['security', '/account/security', 'Security & sign-in', 'lock']].forEach(function (n) { %>
        <li><a href="<%= n[1] %>"<% if (it.nav === n[0]) { %> aria-current="page"<% } %>><span class="tile"><img class="off" src="/assets/icons/<%= n[3] %>.svg" alt="" width="18" height="18"><img class="on" src="/assets/icons/<%= n[3] %>-on.svg" alt="" width="18" height="18"></span><%= n[2] %></a></li>
<% }) %>
      </ul>
    </nav>
    <main class="acct-main" aria-labelledby="title">
      <div class="acct-content">
<% if (it.done) { %>        <p class="flash" role="status"><%= it.done %></p>
<% } %>
<%~ it.body %>
      </div>
    </main>
  </div>
</div>
<% } else { %>
<div class="page">
  <main class="card" aria-labelledby="title">
    <div class="card-body">
<%~ it.body %>
    </div>
  </main>
<% if (it.links && it.links.length) { %>
  <footer class="foot">
    <nav class="links" aria-label="About <%= it.providerName %>">
<% it.links.forEach(function (l) { %>
      <a href="<%= l.href %>"><%= l.label %></a>
<% }) %>
    </nav>
  </footer>
<% } %>
</div>
<% } %>
  <script src="/assets/password.js" defer></script>
</body>
</html>
