<% layout('./layout') %>
<% var verified = it.identifiers.filter(function (r) { return r.verified; }); var checks = []; %>
<% if (!it.profile.passwordSetAt) checks.push({ icon: 'lock-20', t: 'No password yet', s: 'Set one so you can sign in without waiting for a code.', href: '/account/password', act: 'Set one' }); %>
<% if (verified.length < 2) checks.push({ icon: 'mail', t: 'Add a backup email or phone', s: "So you can still get in if you lose access to " + (it.who || 'your address') + '.', href: '/account/contact#add', act: 'Add' }); %>
<section class="profile" aria-labelledby="title">
  <span class="avatar-i" aria-hidden="true"><%= it.initials %></span>
  <h1 id="title"><%= it.name || 'Your account' %></h1>
  <p><%= it.who %></p>
<% if (it.apps && it.apps.length) { %>
  <ul class="apps" aria-label="Apps you can use with this account">
<% it.apps.forEach(function (a) { %>
    <li><a class="app" href="<%= a.url %>"><% if (a.logo) { %><img src="<%= a.logo %>" alt="" width="20" height="20"><% } %><%= a.name %></a></li>
<% }) %>
  </ul>
<% } %>
</section>
<section class="panel" aria-labelledby="h-check">
  <div class="panel-head">
    <h2 id="h-check">Security check</h2>
    <p><%= checks.length === 0 ? 'Nothing to review right now.' : checks.length === 1 ? '1 thing to review to keep your account safe.' : checks.length + ' things to review to keep your account safe.' %></p>
  </div>
  <ul class="rows">
<% checks.forEach(function (c) { %>
    <li class="row">
      <span class="tile"><img src="/assets/icons/<%= c.icon %>.svg" alt="" width="20" height="20"></span>
      <span class="text"><span class="t"><%= c.t %></span><span class="s"><%= c.s %></span></span>
      <a class="btn stroke small" href="<%= c.href %>"><%= c.act %><span class="sr">: <%= c.t %></span></a>
    </li>
<% }) %>
    <li><a class="row" href="/account/security">
      <span class="tile"><img src="/assets/icons/shield-20.svg" alt="" width="20" height="20"></span>
      <span class="text"><span class="t">Security &amp; sign-in</span><span class="s">How you sign in, and your password.</span></span>
      <img class="go" src="/assets/icons/chevron-right.svg" alt="" width="20" height="20">
    </a></li>
  </ul>
</section>
