<% layout('./layout') %>
<% var emails = it.identifiers.filter(function (r) { return r.kind === 'email'; }); var phones = it.identifiers.filter(function (r) { return r.kind === 'phone'; }); var verified = it.identifiers.filter(function (r) { return r.verified; }).length; %>
<div class="page-head">
  <a class="back" href="/account/personal"><img src="/assets/icons/arrow-left.svg" alt="" width="18" height="18">Personal info</a>
  <h1 id="title">Email and phone</h1>
  <p>The addresses you sign in with and get codes at. Your primary email is where we send security alerts.</p>
</div>
<% if (it.error) { %><p id="contact-error" class="flash bad" role="alert"><%~ include('../_alert-icon') %><span><%= it.error %></span></p><% } %>
<% [['email', 'Email addresses', emails], ['phone', 'Phone numbers', phones]].forEach(function (group) { if (group[0] === 'phone' && !phones.length) return; %>
<section class="panel" aria-labelledby="h-<%= group[0] %>">
  <div class="panel-head"><h2 id="h-<%= group[0] %>"><%= group[1] %></h2></div>
  <ul class="rows">
<% if (!group[2].length) { %>
    <li class="row"><span class="text"><span class="s">None yet.</span></span></li>
<% } %>
<% group[2].forEach(function (r) { %>
    <li class="row">
      <span class="tile"><img src="/assets/icons/<%= r.kind === 'email' ? 'mail' : 'mobile' %>.svg" alt="" width="20" height="20"></span>
      <span class="text"><span class="t"><span class="val"><%= r.value %></span><% if (r.primary) { %><span class="tag inverse">Primary</span><% } else if (r.verified) { %><span class="tag">Verified</span><% } else { %><span class="tag bad">Not verified</span><% } %></span></span>
      <span class="do">
<% if (r.verified && !r.primary) { %>
        <form method="post" action="/account/contact/primary">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
          <input type="hidden" name="id" value="<%= r.id %>">
          <button type="submit" class="btn stroke small">Make primary<span class="sr"> <%= r.value %></span></button>
        </form>
<% } %>
<% if (verified > 1 || !r.verified) { %>
        <form method="post" action="/account/contact/remove">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
          <input type="hidden" name="id" value="<%= r.id %>">
          <button type="submit" class="btn stroke small">Remove<span class="sr"> <%= r.value %></span></button>
        </form>
<% } %>
      </span>
    </li>
<% }) %>
  </ul>
</section>
<% }) %>
<section id="add" class="panel pad" aria-labelledby="h-add">
  <div class="panel-head"><h2 id="h-add">Add <%= it.phones ? 'an email or phone' : 'an email address' %></h2><p>We'll send it a code to confirm it's yours.</p></div>
<% (it.phones ? ['email', 'phone'] : ['email']).forEach(function (kind) { %>
  <form method="post" action="/account/contact/add" novalidate>
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
    <input type="hidden" name="kind" value="<%= kind %>">
    <div class="field">
      <label for="add-<%= kind %>"><%= kind === 'email' ? 'Email address' : 'Phone number' %></label>
      <input id="add-<%= kind %>" class="text" name="value" type="<%= kind === 'email' ? 'email' : 'tel' %>" autocomplete="<%= kind === 'email' ? 'email' : 'tel' %>" autocapitalize="none" spellcheck="false" required placeholder="<%= kind === 'email' ? 'you@example.com' : '+44 7700 900123' %>" value="<%= it.adding === kind ? it.typed : '' %>"<% if (it.adding === kind && it.error) { %> aria-invalid="true" aria-describedby="contact-error"<% } %>>
    </div>
    <div class="actions">
      <button type="submit" class="btn stroke">Send code<span class="sr"> to this <%= kind === 'email' ? 'email address' : 'phone number' %></span></button>
    </div>
  </form>
<% }) %>
</section>
