<% layout('./layout') %>
<% var where = it.channel === 'email' ? 'your email' : 'WhatsApp'; %>
<div class="intro">
<%~ include('./_logo', it) %>
<% if (it.locked) { %>
  <h1 id="title">Too many wrong codes</h1>
<% } else if (it.rateLimited) { %>
  <h1 id="title">Please wait before asking again</h1>
<% } else if (it.expired) { %>
  <h1 id="title"><%= it.ticketExpired ? (it.purpose === 'signup' ? 'Your sign-up took too long' : 'Your reset took too long') : 'That code has expired' %></h1>
<% } else if (it.purpose === 'recovery') { %>
  <h1 id="title">Reset your password</h1>
<% } else if (it.purpose === 'signup') { %>
  <h1 id="title">Verify your <%= it.channel === 'email' ? 'email' : 'number' %></h1>
<% } else { %>
  <h1 id="title">Check <%= where %></h1>
<% } %>
<%~ include('./_pill', it) %>
</div>
<div class="form">
<% if (it.locked) { %>
  <p class="text-block" role="alert">For your security, no more codes can be sent to <strong><%= it.destination %></strong> for <%= it.minutes === 1 ? '1 minute' : it.minutes + ' minutes' %>.</p>
<% } else if (it.rateLimited) { %>
  <p class="text-block" role="alert">We've sent as many codes to <strong><%= it.destination %></strong> as we can for now. You can ask for another in <%= it.minutes === 1 ? '1 minute' : it.minutes + ' minutes' %>.</p>
<% } else if (it.expired) { %>
<% if (it.ticketExpired && it.purpose === 'signup') { %>
  <p class="text-block" role="alert">Nothing was saved. Start again to create your account.</p>
  <div class="actions">
    <a class="btn" href="/login?login_challenge=<%= encodeURIComponent(it.challenge) %>">Start again</a>
  </div>
<% } else { %>
  <p class="text-block" role="alert"><%= it.ticketExpired ? 'Send a new code to start again.' : 'It was used already, or too much time passed. Send a new one.' %></p>
  <div class="actions">
    <form method="post" action="/login">
<%~ include('./_hidden', it) %>
      <input type="hidden" name="purpose" value="<%= it.purpose %>">
      <button type="submit" name="action" value="send_code" class="btn">Send a new code</button>
    </form>
  </div>
<% } %>
<% } else { %>
  <p class="text-block">Enter the <%= it.code.codeLength %>-digit code we sent to <strong><%= it.destination %></strong><%= it.purpose === 'signup' ? ' to confirm it’s yours' : '' %>.</p>
  <form id="verify" method="post" action="/login">
<%~ include('./_hidden', it) %>
    <input type="hidden" name="otp_id" value="<%= it.code.otpId %>">
    <div class="code"<% if (it.error) { %> data-invalid<% } %>>
      <label for="code" class="sr"><%= it.code.codeLength %>-digit code</label>
      <input id="code" class="text" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="<%= it.code.codeLength %>" data-length="<%= it.code.codeLength %>" required autofocus<% if (it.error) { %> aria-invalid="true" aria-describedby="code-error"<% } %>>
<% if (it.error) { %>
      <p id="code-error" class="error" role="alert"><%~ include('./_alert-icon') %><span><%= it.error %><% if (it.remaining !== null) { %> <%= it.remaining === 1 ? '1 attempt' : it.remaining + ' attempts' %> left.<% } %></span></p>
<% } %>
    </div>
  </form>
  <form method="post" action="/login">
<%~ include('./_hidden', it) %>
    <input type="hidden" name="purpose" value="<%= it.purpose %>">
    <button type="submit" name="action" value="send_code" class="link">Send the code again</button>
  </form>
  <div class="actions">
<% if (it.purpose === 'sign_in') { %>
    <form method="post" action="/login">
<%~ include('./_hidden', it) %>
      <button type="submit" name="action" value="ways" class="btn ghost">Try another way</button>
    </form>
<% } else if (it.purpose === 'recovery') { %>
    <form method="post" action="/login">
<%~ include('./_hidden', it) %>
      <button type="submit" name="action" value="identify" class="btn ghost">Back</button>
    </form>
<% } %>
    <button type="submit" form="verify" name="action" value="verify_code" class="btn">Next</button>
  </div>
<% } %>
</div>
