<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %> · <%= it.providerName %></title>
  <link rel="icon" type="image/svg+xml" href="<%= asset('entity-auth.svg') %>">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= asset('entity-auth-32.png') %>">
  <link rel="apple-touch-icon" href="<%= asset('entity-auth-180.png') %>">
  <link rel="preload" href="<%= asset('geist.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('entity-auth.css') %>">
</head>
<body>
<div class="page">
  <main class="card" aria-labelledby="title">
<% if (it.clientName && !it.plain && !it.confirm) { %>
    <div class="card-head">
      <img src="<%= asset('icons/entity-mark-20.svg') %>" alt="" width="20" height="20">
      <span>Sign in with <%= it.providerName %></span>
    </div>
<% } %>
    <div class="card-body">
<%~ it.body %>
    </div>
  </main>
  <footer class="foot">
<% if (it.backTo && it.challenge) { %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
      <input type="hidden" name="login_challenge" value="<%= it.challenge %>">
      <button type="submit" name="action" value="cancel" class="quiet" formnovalidate>
        <img src="<%= asset('icons/arrow-left.svg') %>" alt="" width="16" height="16">
        <span>Back to <%= it.backTo %></span>
      </button>
    </form>
<% } %>
<% if (it.links && it.links.length) { %>
    <nav class="links" aria-label="About <%= it.providerName %>">
<% it.links.forEach(function (l) { %>
      <a href="<%= l.href %>"><%= l.label %></a>
<% }) %>
    </nav>
<% } %>
  </footer>
</div>
  <script src="<%= asset('password.js') %>" defer></script>
</body>
</html>
