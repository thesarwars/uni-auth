<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %> · <%= it.providerName %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/entity-auth-32.png">
  <link rel="apple-touch-icon" href="/assets/entity-auth-180.png">
  <style>
    /* Placeholder styling until the design tokens arrive (auth-plan.md section 7.4). --field edges
       fields and secondary buttons at 3:1 or more (WCAG 1.4.11); --line is decoration only.
       --ok and --warn colour the password checklist and strength meter, text and graphics both.
       tests/e2e/accessibility.e2e.test.ts checks every pair. */
    :root { --bg: #f6f6f4; --card: #fff; --ink: #1b1b1a; --muted: #5d5d58; --line: #d9d9d4; --field: #85857f; --accent: #1b1b1a; --accent-ink: #fff; --danger: #a4231c; --ok: #1a7f37; --warn: #8a5a00; }
    @media (prefers-color-scheme: dark) { :root { --bg: #121211; --card: #1c1c1b; --ink: #ededea; --muted: #a3a39d; --line: #34342f; --field: #77776f; --accent: #ededea; --accent-ink: #121211; --danger: #f08a80; --ok: #6fd08c; --warn: #e3b341; } }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 16px; }
    main { width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 32px 28px; }
    h1 { font-size: 1.375rem; line-height: 1.3; margin: 0 0 8px; }
    p { margin: 0 0 16px; color: var(--muted); }
    .logo { width: 48px; height: 48px; border-radius: 10px; margin-bottom: 16px; }
    .actions { display: grid; gap: 10px; margin-top: 24px; }
    button, .button { font: inherit; font-weight: 600; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--accent); background: var(--accent); color: var(--accent-ink); cursor: pointer; text-align: center; text-decoration: none; }
    button.secondary { background: transparent; color: var(--ink); border-color: var(--field); }
    button:focus-visible, .button:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
    .notice { border-left: 3px solid var(--danger); padding: 8px 12px; color: var(--ink); background: transparent; }
    label { display: block; font-weight: 600; margin: 16px 0 6px; }
    input[type=text], input[type=password], input[type=email], input[type=tel] { width: 100%; font: inherit; padding: 11px 12px; border: 1px solid var(--field); border-radius: 8px; background: var(--card); color: var(--ink); }
    input[readonly] { color: var(--muted); }
    input:focus-visible { outline: 3px solid var(--ink); outline-offset: 1px; }
    input[aria-invalid=true] { border-color: var(--danger); }
    .error { color: var(--danger); margin: 8px 0 0; }
    .hint { font-size: .875rem; margin: 8px 0 0; }
    .links { margin-top: 16px; }
    a { color: var(--ink); }
    form.inline { margin-top: 12px; }
    button.link { background: none; border: 0; padding: 4px 0; color: var(--ink); text-decoration: underline; font-weight: 400; }
    .secret { position: relative; }
    .secret input { padding-right: 48px; }
    button.reveal { position: absolute; top: 50%; right: 4px; transform: translateY(-50%); display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: var(--muted); }
    button.reveal[hidden] { display: none; }
    button.reveal:hover { color: var(--ink); }
    button.reveal .eye-off, button.reveal[aria-pressed=true] .eye { display: none; }
    button.reveal[aria-pressed=true] .eye-off { display: block; }
    .rules { list-style: none; margin: 10px 0 0; padding: 0; color: var(--muted); font-size: .9375rem; }
    .rules li, .match { display: flex; align-items: center; gap: 8px; margin: 4px 0; }
    .tick, .match::before { position: relative; flex: none; width: 16px; height: 16px; border: 1.5px solid var(--field); border-radius: 50%; }
    .match { position: relative; }
    .match[hidden], .strength[hidden] { display: none; }
    .match::before { content: ""; }
    .rules .met, .match.met { color: var(--ink); }
    .rules .met .tick, .match.met::before { border-color: var(--ok); background: var(--ok); }
    /* The tick is drawn in the card colour, so it holds 3:1 on --ok in both schemes. */
    .rules .met .tick::after, .match.met::after { content: ""; position: absolute; width: 4px; height: 8px; border: solid var(--card); border-width: 0 2px 2px 0; transform: rotate(45deg); }
    .rules .met .tick::after { left: 4px; top: 1px; }
    .match.met::after { left: 6px; top: 4px; }
    .rules .unmet { color: var(--danger); }
    .rules .unmet .tick { border-color: var(--danger); }
    .match { font-size: .9375rem; color: var(--muted); }
    .strength { margin: 12px 0 0; }
    .strength p { margin: 6px 0 0; font-size: .875rem; }
    .meter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
    .meter span { height: 4px; border-radius: 2px; background: var(--line); }
    .strength[data-level="1"] .meter span:nth-child(-n+1) { background: var(--danger); }
    .strength[data-level="2"] .meter span:nth-child(-n+2) { background: var(--warn); }
    .strength[data-level="3"] .meter span:nth-child(-n+3), .strength[data-level="4"] .meter span { background: var(--ok); }
    .strength[data-level="1"] strong { color: var(--danger); }
    .strength[data-level="2"] strong { color: var(--warn); }
    .strength[data-level="3"] strong, .strength[data-level="4"] strong { color: var(--ok); }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .upstreams { display: grid; gap: 10px; margin-top: 20px; }
    .or { text-align: center; margin: 0; font-size: .875rem; }
    footer { margin-top: 24px; font-size: .875rem; color: var(--muted); }
    /* The provider's mark, on every screen: who is asking for the password, before which app it is for. */
    .brand { display: flex; align-items: center; gap: 10px; margin: 0 0 24px; font-weight: 600; color: var(--ink); }
    .brand img { width: 40px; height: 40px; border-radius: 10px; box-shadow: 0 0 0 1px var(--line); }
  </style>
</head>
<body>
  <main>
  <p class="brand"><img src="/assets/entity-auth-120.png" alt=""><%= it.providerName %></p>
<%~ it.body %>
  </main>
  <script src="/assets/password.js" defer></script>
</body>
</html>
