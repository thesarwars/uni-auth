<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %> · <%= it.providerName %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/entity-auth.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/entity-auth-32.png">
  <link rel="apple-touch-icon" href="/assets/entity-auth-180.png">
  <link rel="preload" href="/assets/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <style>
    /* The entity-auth design (docs/entity-auth Sign in.html). Inter is served from this origin
       (public/inter-latin.woff2, SIL Open Font License 1.1), as the CSP allows nothing else.
       Components use only the tokens; tests/e2e/accessibility.e2e.test.ts checks each pair.
       --border-field departs from the design's 12% black: a field's edge holds 3:1 (WCAG 1.4.11). */
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400 700; font-display: swap; src: url(/assets/inter-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    :root {
      --bg-page: #f6f6f6; --bg-surface: #ffffff; --bg-subtle: #f3f3f3; --bg-subtle-hover: #efefef;
      --text-primary: #141414; --text-secondary: #525252; --text-tertiary: #6b6b6b; --text-disabled: #9c9c9c; --text-on-action: #ffffff;
      --border-subtle: rgba(0,0,0,.08); --border-field: #8a8a8a; --border-focus: #141414; --ring-focus: rgba(0,0,0,.08); --link-underline: rgba(0,0,0,.24);
      --action-primary: #0a0a0a; --action-primary-hover: #2a2a2a; --action-disabled: #efefef;
      --meter-fill: #141414; --meter-track: #e5e5e5; --check-done: #141414; --check-todo: #b5b5b5; --separator: #b5b5b5;
      --status-error: #b14848; --status-error-ring: rgba(177,72,72,.10); --status-success: #c97a4b; --status-success-bg: rgba(201,122,75,.10);
      --shadow-card: 0 1px 2px rgba(0,0,0,.04), 0 24px 48px -24px rgba(0,0,0,.12); --shadow-button: 0 1px 2px rgba(0,0,0,.12);
    }
    * { box-sizing: border-box; }
    body { margin: 0; }
    .page { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg-page); color: var(--text-primary); font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.4; letter-spacing: -0.006em; -webkit-font-smoothing: antialiased; }
    a { color: var(--text-primary); }
    .sr { position: absolute !important; width: 1px !important; height: 1px !important; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    :focus-visible { outline: 2px solid var(--border-focus); outline-offset: 2px; }

    .top { display: flex; align-items: center; padding: 16px 24px; min-height: 76px; }
    .top form { margin: 0; }
    .quiet { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 8px; border: 0; border-radius: 10px; background: none; font: inherit; font-size: 14px; line-height: 1; font-weight: 500; color: var(--text-secondary); text-decoration: none; cursor: pointer; }
    .top .quiet { margin-left: -8px; }
    .quiet:hover { color: var(--text-primary); }

    main { flex: 1; display: flex; align-items: flex-start; justify-content: center; padding: 104px 16px 64px; }
    .card { width: 100%; max-width: 440px; display: flex; flex-direction: column; padding: 40px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 24px; box-shadow: var(--shadow-card); }
    .card > form { display: flex; flex-direction: column; margin: 0; }
    .mark { display: block; width: 40px; height: 40px; }
    h1 { margin: 28px 0 0; font-size: 28px; line-height: 1.15; font-weight: 600; letter-spacing: -0.025em; }
    .done h1 { margin-top: 24px; }
    .lede { margin: 10px 0 0; font-size: 15px; line-height: 1.4; color: var(--text-secondary); text-wrap: pretty; }
    .pill + .lede { margin-top: 16px; }
    .lede strong { font-weight: 500; color: var(--text-primary); }
    .notice { margin: 16px 0 0; padding: 12px 14px; border-radius: 12px; background: var(--bg-subtle); font-size: 14px; color: var(--text-primary); }

    .pill { align-self: flex-start; display: inline-flex; margin-top: 12px; padding: 4px 0; border-radius: 999px; color: var(--text-primary); text-decoration: none; max-width: 100%; }
    .pill > span { display: inline-flex; align-items: center; gap: 8px; height: 36px; max-width: 100%; padding: 0 12px 0 3px; border-radius: 999px; background: var(--bg-subtle); border: 1px solid var(--border-subtle); }
    .pill:hover > span { background: var(--bg-subtle-hover); }
    .pill .avatar { flex: none; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--bg-surface); border: 1px solid var(--border-subtle); color: var(--text-secondary); }
    .pill .who { font-size: 14px; line-height: 1; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pill .chev { flex: none; color: var(--text-tertiary); }

    .field { margin-top: 28px; display: flex; flex-direction: column; gap: 10px; }
    .field + .field { margin-top: 24px; }
    .field-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    label { font-size: 14px; line-height: 1; font-weight: 500; }
    input.text { width: 100%; height: 48px; padding: 0 16px; border-radius: 12px; border: 1px solid var(--border-field); background: var(--bg-surface); color: var(--text-primary); font: inherit; font-size: 15px; line-height: 1; outline: none; }
    input.text::placeholder { color: var(--text-tertiary); }
    input.text:focus { border-color: var(--border-focus); box-shadow: 0 0 0 4px var(--ring-focus); }
    input.text[aria-invalid=true] { border-color: var(--status-error); box-shadow: 0 0 0 4px var(--status-error-ring); }
    .hint { margin: 0; font-size: 13px; line-height: 1.4; color: var(--text-tertiary); }

    .secret { position: relative; }
    .secret input.text { padding-right: 52px; }
    .secret input[type=password] { letter-spacing: 0.12em; }
    button.reveal { position: absolute; top: 2px; right: 2px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 10px; background: transparent; color: var(--text-tertiary); cursor: pointer; }
    button.reveal:hover { color: var(--text-primary); background: var(--bg-subtle); }
    button.reveal[hidden] { display: none; }
    button.reveal .eye-off, button.reveal[aria-pressed=true] .eye { display: none; }
    button.reveal[aria-pressed=true] .eye-off { display: block; }

    .error { margin: 2px 0 0; display: flex; align-items: flex-start; gap: 6px; font-size: 13px; line-height: 1.4; color: var(--status-error); }
    .error svg { flex: none; margin-top: 1px; }
    .error a, .error button.link { color: inherit; font-weight: 500; text-decoration-color: currentColor; }

    .btn { margin-top: 24px; width: 100%; height: 48px; display: flex; align-items: center; justify-content: center; padding: 0 16px; border: 0; border-radius: 12px; background: var(--action-primary); color: var(--text-on-action); box-shadow: var(--shadow-button); font: inherit; font-size: 15px; line-height: 1; font-weight: 500; text-decoration: none; cursor: pointer; transition: background-color .15s ease; }
    .btn:hover { background: var(--action-primary-hover); }
    .btn:disabled { background: var(--action-disabled); color: var(--text-disabled); box-shadow: none; cursor: not-allowed; }
    .btn.secondary { margin-top: 0; background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-field); box-shadow: none; }
    .btn.secondary:hover { background: var(--bg-subtle); }
    .btn + .btn { margin-top: 10px; }

    .link, button.link { padding: 0; border: 0; background: none; font: inherit; font-weight: 500; color: var(--text-primary); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 3px; cursor: pointer; transition: text-decoration-color .15s ease; }
    .link:hover, button.link:hover { text-decoration-color: currentColor; }
    .field-head .link { display: inline-flex; align-items: center; height: 44px; margin: -15px 0; font-size: 14px; line-height: 1; }

    .or { display: flex; align-items: center; gap: 12px; margin: 24px 0 16px; font-size: 13px; color: var(--text-tertiary); }
    .or::before, .or::after { content: ""; flex: 1; height: 1px; background: var(--border-subtle); }
    .upstreams { display: flex; flex-direction: column; gap: 10px; margin: 0; }

    .band { margin: 32px -40px -40px; padding: 20px 40px; background: var(--bg-subtle); border-top: 1px solid var(--border-subtle); border-radius: 0 0 23px 23px; }
    .band p { margin: 0; font-size: 14px; line-height: 1.4; color: var(--text-secondary); text-align: center; text-wrap: pretty; }
    .band p + p { margin-top: 8px; }
    .band form { display: inline; margin: 0; }

    /* Choosing a password: strength meter, then the policy's rules. */
    .checks { margin-top: 4px; display: flex; flex-direction: column; gap: 16px; }
    .strength { display: flex; align-items: center; gap: 12px; }
    .strength[hidden] { display: none; }
    .meter { flex: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
    .meter span { height: 4px; border-radius: 2px; background: var(--meter-track); }
    .strength[data-level="1"] .meter span:nth-child(-n+1), .strength[data-level="2"] .meter span:nth-child(-n+2),
    .strength[data-level="3"] .meter span:nth-child(-n+3), .strength[data-level="4"] .meter span { background: var(--meter-fill); }
    .strength p { min-width: 48px; margin: 0; text-align: right; font-size: 13px; line-height: 1; font-weight: 500; color: var(--text-secondary); }
    .strength[data-level="4"] p { color: var(--text-primary); }
    .strength[data-level="0"] p { visibility: hidden; }
    .strength strong { font-weight: inherit; }
    .rules { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .rules li, .match { display: flex; align-items: center; gap: 8px; font-size: 13px; line-height: 1; color: var(--text-tertiary); }
    .tick, .match::before { position: relative; flex: none; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--check-todo); }
    .match { position: relative; margin: 0; }
    .match[hidden] { display: none; }
    .match::before { content: ""; }
    .rules .met, .match.met { color: var(--text-secondary); }
    .rules .met .tick, .match.met::before { border: 0; background: var(--check-done); }
    .rules .met .tick::after, .match.met::after { content: ""; position: absolute; width: 3.5px; height: 7px; border: solid var(--text-on-action); border-width: 0 1.75px 1.75px 0; transform: rotate(45deg); }
    .rules .met .tick::after { left: 6px; top: 3.5px; }
    .match.met::after { left: 6px; top: 4px; }
    .rules .unmet { color: var(--status-error); }
    .rules .unmet .tick { border-color: var(--status-error); }

    /* The code: one real input. With password.js it sits invisibly over six boxes that show it. */
    .code { margin-top: 28px; position: relative; }
    .code input.text { font-size: 24px; font-weight: 600; letter-spacing: 0.4em; text-align: center; font-variant-numeric: tabular-nums; height: 56px; }
    .code.boxed input.text { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; z-index: 1; cursor: text; }
    .boxes { display: none; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
    .code.boxed .boxes { display: grid; }
    .boxes span { height: 56px; display: flex; align-items: center; justify-content: center; border-radius: 12px; border: 1px solid var(--border-field); background: var(--bg-surface); font-size: 24px; line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; }
    .code.boxed.focused .boxes span.at { border-color: var(--border-focus); box-shadow: 0 0 0 4px var(--ring-focus); }
    .code.boxed.focused .boxes span.at:empty::after { content: ""; width: 2px; height: 24px; border-radius: 1px; background: var(--text-primary); animation: blink 1.1s steps(1) infinite; }
    .code.boxed[data-invalid] .boxes span { border-color: var(--status-error); }
    .code .error { margin-top: 12px; }
    @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .code.boxed.focused .boxes span.at:empty::after { animation: none; } }

    .badge { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--status-success-bg); color: var(--status-success); }

    .foot { display: flex; justify-content: center; align-items: center; gap: 4px; padding: 0 16px 12px; }
    .foot a { display: inline-flex; align-items: center; height: 44px; padding: 0 8px; font-size: 13px; line-height: 1; color: var(--text-tertiary); text-decoration: none; }
    .foot a:hover { color: var(--text-primary); }
    .foot .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--separator); }

    @media (max-height: 820px) { main { padding-top: 40px; } }
    @media (max-width: 480px) {
      .page { background: var(--bg-surface); }
      main { padding: 4px 20px 40px; }
      .card { padding: 12px 0 0; border: 0; border-radius: 0; box-shadow: none; background: transparent; }
      .band { margin: 28px 0 0; padding: 0; border: 0; background: transparent; }
    }
  </style>
</head>
<body>
<div class="page">
<% if (it.backTo) { %>
  <header class="top">
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
      <input type="hidden" name="login_challenge" value="<%= it.challenge %>">
      <button type="submit" name="action" value="cancel" class="quiet" formnovalidate>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12H4"/><path d="M9 17s-5-3.7-5-5 5-5 5-5"/></svg>
        <span>Back to <%= it.backTo %></span>
      </button>
    </form>
  </header>
<% } %>
  <main>
    <section class="card<%= it.done ? ' done' : '' %>" aria-labelledby="title">
<% if (!it.done) { %>
      <img class="mark" src="/assets/entity-auth.svg" alt="<%= it.providerName %>" width="40" height="40">
<% } %>
<%~ it.body %>
    </section>
  </main>
<% if (it.links && it.links.length) { %>
  <footer class="foot">
<% it.links.forEach(function (l, i) { %>
    <% if (i) { %><span class="dot" aria-hidden="true"></span><% } %><a href="<%= l.href %>"><%= l.label %></a>
<% }) %>
  </footer>
<% } %>
</div>
  <script src="/assets/password.js" defer></script>
</body>
</html>
