<% layout('./layout') %>
<div class="intro">
<%~ include('./_logo', it) %>
  <h1 id="title">Sign out of <%= it.providerName %>?</h1>
</div>
<div class="form">
  <p class="text-block">You will be signed out of every app that uses <%= it.providerName %> on this browser.</p>
  <form method="post" action="/logout">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
    <input type="hidden" name="logout_challenge" value="<%= it.challenge %>">
    <div class="actions">
      <button type="submit" name="action" value="cancel" class="btn ghost">Cancel</button>
      <button type="submit" name="action" value="sign_out" class="btn">Sign out</button>
    </div>
  </form>
</div>
