<%/* A password input with its show/hide button. The button stays hidden until public/password.js
   runs, so without JavaScript nothing is shown that does nothing. */%>
<div class="secret">
  <input id="<%= it.id %>" name="<%= it.name %>" type="password" autocomplete="<%= it.autocomplete %>" required<% if (it.autofocus) { %> autofocus<% } %><% if (it.describedby) { %> aria-describedby="<%= it.describedby %>"<% } %><% if (it.invalid) { %> aria-invalid="true"<% } %>>
  <button type="button" class="reveal" data-reveal="<%= it.id %>" aria-label="Show password" aria-pressed="false" hidden>
    <svg class="eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
    <svg class="eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.5 17.5 0 0 1-2.2 3.1M6.6 6.6A17.3 17.3 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/><path d="m2 2 20 20"/></svg>
  </button>
</div>
