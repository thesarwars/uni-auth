<%/* A password input with its show/hide button. The button stays hidden until public/password.js
   runs, so without JavaScript nothing is shown that does nothing. */%>
<div class="secret">
  <input id="<%= it.id %>" class="text" name="<%= it.name %>" type="password" autocomplete="<%= it.autocomplete %>" required<% if (it.autofocus) { %> autofocus<% } %><% if (it.describedby) { %> aria-describedby="<%= it.describedby %>"<% } %><% if (it.invalid) { %> aria-invalid="true"<% } %>>
  <button type="button" class="reveal" data-reveal="<%= it.id %>" aria-label="Show password" aria-pressed="false" hidden>
    <svg class="eye-off" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.43 6.52C4.22 7.89 2.93 9.86 2.32 11.03c-.21.4-.32.61-.32.98s.11.57.32.97C3.33 14.91 6.17 19.02 11.97 19.02c2.28 0 4.1-.63 5.53-1.52"/><path d="M9.88 9.88a3 3 0 0 0 4.24 4.24"/><path d="M10 5.12c.63-.08 1.29-.12 1.97-.12 5.8 0 8.64 4.11 9.65 6.04.21.4.32.6.32.97s-.11.57-.32.98a12.6 12.6 0 0 1-1.62 2.36"/><path d="M3 3l18 18"/></svg>
    <svg class="eye" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12c2.5-4.5 6-6.5 10-6.5s7.5 2 10 6.5c-2.5 4.5-6 6.5-10 6.5S4.5 16.5 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>
</div>
