<% layout('./layout') %>
<div class="intro">
<%~ include('./_logo', it) %>
  <h1 id="title">Reset your password</h1>
<%~ include('./_pill', it) %>
</div>
<div class="form">
  <p class="text-block">We'll <%= it.channel === 'email' ? 'email you' : 'send you on WhatsApp' %> a <%= it.codeLength %>-digit code to confirm it's you. Then you can choose a new password.</p>
  <div class="actions">
    <form method="post" action="/login">
<%~ include('./_hidden', it) %>
      <button type="submit" name="action" value="identify" class="btn ghost">Back</button>
    </form>
    <form method="post" action="/login">
<%~ include('./_hidden', it) %>
      <input type="hidden" name="purpose" value="recovery">
      <button type="submit" name="action" value="send_code" class="btn">Send code</button>
    </form>
  </div>
</div>
