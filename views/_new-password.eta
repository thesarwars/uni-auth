<%/* Choosing a password: the field, the policy's rules, a strength meter and the repeat field.
   The rules are the server's (checkPassword); public/password.js ticks them as the member
   types, and the server checks them again on submit. */%>
<label for="password"><%= it.label %></label>
<%~ include('./_password', { id: 'password', name: 'password', autocomplete: 'new-password', autofocus: true, describedby: 'rules strength' + (it.error ? ' password-error' : ''), invalid: !!it.error }) %>
<ul id="rules" class="rules">
<% it.rules.forEach(function (r) { %>
  <li data-rule="<%= r.rule %>"<% if (r.value !== undefined) { %> data-value="<%= r.value %>"<% } %> class="<%= it.checked ? (r.met ? 'met' : 'unmet') : '' %>"><span class="tick" aria-hidden="true"></span><%= r.label %><span class="sr state"><%= it.checked ? (r.met ? ' (done)' : ' (not yet)') : '' %></span></li>
<% }) %>
</ul>
<div id="strength" class="strength" data-level="0" aria-live="polite" hidden>
  <div class="meter" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <p>Password strength: <strong>-</strong></p>
</div>
<label for="confirm">Type it again</label>
<%~ include('./_password', { id: 'confirm', name: 'confirm', autocomplete: 'new-password', describedby: 'match' }) %>
<p id="match" class="match" aria-live="polite" hidden></p>
<% if (it.error) { %><p id="password-error" class="error" role="alert"><%= it.error %></p><% } %>
