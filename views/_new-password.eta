<%/* Choosing a password: the field, the repeat field and the policy's rules. The rules are the
   server's (checkPassword); public/password.js ticks them as the member types, and the server
   checks them again on submit. */%>
<div class="field">
  <label for="password"><%= it.label %></label>
<%~ include('./_password', { id: 'password', name: 'password', autocomplete: 'new-password', autofocus: true, describedby: 'rules' + (it.error ? ' password-error' : ''), invalid: !!it.error }) %>
</div>
<div class="field">
  <label for="confirm"><%= it.confirmLabel %></label>
<%~ include('./_password', { id: 'confirm', name: 'confirm', autocomplete: 'new-password', describedby: 'match' }) %>
  <p id="match" class="match" aria-live="polite" hidden></p>
</div>
<ul id="rules" class="rules" aria-label="Your password needs">
<% it.rules.forEach(function (r) { %>
  <li data-rule="<%= r.rule %>"<% if (r.value !== undefined) { %> data-value="<%= r.value %>"<% } %> class="<%= it.checked ? (r.met ? 'met' : 'unmet') : '' %>"><%= r.label %><span class="sr state"><%= it.checked ? (r.met ? ' (done)' : ' (not yet)') : '' %></span></li>
<% }) %>
</ul>
<% if (it.error) { %>
<p id="password-error" class="error" role="alert"><%~ include('./_alert-icon') %><span><%= it.error %></span></p>
<% } %>
