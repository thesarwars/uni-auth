<% layout('./layout') %>
<%~ include('./_header', it) %>
<h1>Choose a new password</h1>
<p>For <strong><%= it.identifier %></strong>. Every other device signed in to this account will be signed out.</p>
<form method="post" action="/login">
<%~ include('./_hidden', it) %>
  <input type="hidden" name="ticket" value="<%= it.ticket %>">
  <input type="text" autocomplete="username" value="<%= it.identifier %>" hidden readonly>
  <label for="password">New password</label>
  <input id="password" name="password" type="password" autocomplete="new-password" required autofocus aria-describedby="rules<% if (it.error) { %> password-error<% } %>"<% if (it.error) { %> aria-invalid="true"<% } %>>
  <ul id="rules" class="rules">
  <% it.rules.forEach(function (r) { %>
    <li class="<%= it.checked ? (r.met ? 'met' : 'unmet') : '' %>"><%= r.label %><% if (it.checked) { %><span class="sr"><%= r.met ? ' (done)' : ' (not yet)' %></span><% } %></li>
  <% }) %>
  </ul>
  <label for="confirm">Type it again</label>
  <input id="confirm" name="confirm" type="password" autocomplete="new-password" required>
  <% if (it.error) { %><p id="password-error" class="error" role="alert"><%= it.error %></p><% } %>
  <div class="actions">
    <button type="submit" name="action" value="new_password">Set password and sign in</button>
  </div>
</form>
<footer>Signing in through <%= it.providerName %></footer>
