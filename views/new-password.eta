<% layout('./layout') %>
<h1 id="title">Set a new password</h1>
<%~ include('./_pill', it) %>
<p class="lede">Your new password works for every app you sign in to with <%= it.providerName %>. Every other device signed in to this account will be signed out.</p>
<form method="post" action="/login">
<%~ include('./_hidden', it) %>
  <input type="hidden" name="ticket" value="<%= it.ticket %>">
  <input type="text" autocomplete="username" value="<%= it.identifier %>" hidden readonly>
<%~ include('./_new-password', { label: 'New password', confirmLabel: 'Confirm new password', rules: it.rules, checked: it.checked, error: it.error }) %>
  <button type="submit" name="action" value="new_password" class="btn">Update password</button>
</form>
