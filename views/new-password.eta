<% layout('./layout') %>
<%~ include('./_header', it) %>
<h1>Choose a new password</h1>
<p>For <strong><%= it.identifier %></strong>. Every other device signed in to this account will be signed out.</p>
<form method="post" action="/login">
<%~ include('./_hidden', it) %>
  <input type="hidden" name="ticket" value="<%= it.ticket %>">
  <input type="text" autocomplete="username" value="<%= it.identifier %>" hidden readonly>
<%~ include('./_new-password', { label: 'New password', rules: it.rules, checked: it.checked, error: it.error }) %>
  <div class="actions">
    <button type="submit" name="action" value="new_password">Set password and sign in</button>
  </div>
</form>
<footer>Signing in through <%= it.providerName %></footer>
