<% layout('./layout') %>
<div class="intro">
<%~ include('./_logo', it) %>
  <h1 id="title">Choose a new password</h1>
<%~ include('./_pill', it) %>
</div>
<div class="form">
  <form method="post" action="/login">
<%~ include('./_hidden', it) %>
    <input type="hidden" name="ticket" value="<%= it.ticket %>">
    <input type="text" autocomplete="username" value="<%= it.identifier %>" hidden readonly>
<%~ include('./_new-password', { label: 'New password', confirmLabel: 'Confirm new password', rules: it.rules, checked: it.checked, error: it.error }) %>
    <p class="legal">It works for every app you sign in to with <%= it.providerName %>. Every other device signed in to this account will be signed out.</p>
    <div class="actions">
      <button type="submit" name="action" value="new_password" class="btn">Save password</button>
    </div>
  </form>
</div>
