<% layout('./layout') %>
<h1 id="title">Too many attempts</h1>
<%~ include('./_pill', it) %>
<p class="lede" role="alert">Sign-in with a password is paused for this account. You can try again in <%= it.minutes === 1 ? '1 minute' : it.minutes + ' minutes' %>, or reset your password now.</p>
<form method="post" action="/login">
<%~ include('./_hidden', it) %>
  <input type="hidden" name="purpose" value="recovery">
  <button type="submit" name="action" value="send_code" class="btn">Reset password</button>
</form>
