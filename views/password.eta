<% layout('./layout') %>
<%~ include('./_header', it) %>
<h1>Enter your password</h1>
<form method="post" action="/login">
  <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
  <input type="hidden" name="login_challenge" value="<%= it.challenge %>">
  <input type="hidden" name="identifier" value="<%= it.identifier %>">
  <!-- Read-only, so a password manager can match the account it is filling. -->
  <label for="username">Signing in as</label>
  <input id="username" type="text" autocomplete="username" value="<%= it.identifier %>" readonly>
  <label for="password">Password</label>
  <input id="password" name="password" type="password" autocomplete="current-password" required autofocus<% if (it.error) { %> aria-invalid="true" aria-describedby="password-error"<% } %>>
  <% if (it.error) { %><p id="password-error" class="error" role="alert"><%= it.error %><% if (it.remaining !== null) { %> <%= it.remaining === 1 ? '1 attempt' : it.remaining + ' attempts' %> left before sign-in is paused.<% } %></p><% } %>
  <div class="actions">
    <button type="submit" name="action" value="password">Sign in</button>
  </div>
</form>
<p class="links"><a href="/login?login_challenge=<%= encodeURIComponent(it.challenge) %>">Not you?</a></p>
<footer>Signing in through <%= it.providerName %></footer>
