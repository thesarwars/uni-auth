<% layout('./layout') %>
<div class="intro">
<%~ include('./_logo', it) %>
  <h1 id="title"><%= it.confirm ? "Confirm it's you" : 'Welcome back' %></h1>
<%~ include('./_pill', it) %>
</div>
<div class="form">
<% if (it.confirm) { %>  <p class="text-block">To keep your account safe, enter your password again before you continue.</p>
<% } %>
<% if (it.notice) { %>  <p class="notice" role="status"><%= it.notice %></p>
<% } %>
  <form id="signin" method="post" action="/login">
<%~ include('./_hidden', it) %>
    <!-- Hidden but filled, so a password manager can match the account it is filling. -->
    <input type="text" autocomplete="username" value="<%= it.identifier %>" hidden readonly>
    <div class="field">
      <label for="password">Enter your password</label>
<%~ include('./_password', { id: 'password', name: 'password', autocomplete: 'current-password', autofocus: true, describedby: it.error ? 'password-error' : '', invalid: !!it.error }) %>
<% if (it.error) { %>
      <p id="password-error" class="error" role="alert"><%~ include('./_alert-icon') %><span><%= it.error %><% if (it.remaining !== null) { %> <%= it.remaining === 1 ? '1 try' : it.remaining + ' tries' %> left before a short pause.<% } %></span></p>
<% } %>
    </div>
  </form>
  <form method="post" action="/login">
<%~ include('./_hidden', it) %>
    <button type="submit" name="action" value="reset" class="link">Forgot password?</button>
  </form>
  <div class="actions">
    <form method="post" action="/login">
<%~ include('./_hidden', it) %>
      <button type="submit" name="action" value="ways" class="btn ghost">Try another way</button>
    </form>
    <button type="submit" form="signin" name="action" value="password" class="btn">Next</button>
  </div>
</div>
