<% layout('./layout') %>
<h1 id="title">Welcome back</h1>
<%~ include('./_pill', it) %>
<% if (it.notice) { %><p class="notice" role="status"><%= it.notice %></p><% } %>
<form method="post" action="/login">
<%~ include('./_hidden', it) %>
  <!-- Hidden but filled, so a password manager can match the account it is filling. -->
  <input type="text" autocomplete="username" value="<%= it.identifier %>" hidden readonly>
  <div class="field">
    <div class="field-head">
      <label for="password">Password</label>
      <button type="submit" form="forgot" class="link">Forgot password?</button>
    </div>
<%~ include('./_password', { id: 'password', name: 'password', autocomplete: 'current-password', autofocus: true, describedby: it.error ? 'password-error' : '', invalid: !!it.error }) %>
<% if (it.error) { %>
    <p id="password-error" class="error" role="alert"><%~ include('./_alert-icon') %><span><%= it.error %><% if (it.remaining !== null) { %> <%= it.remaining === 1 ? '1 attempt' : it.remaining + ' attempts' %> left before sign-in is paused.<% } %> Try again or <button type="submit" form="forgot" class="link">reset it</button>.</span></p>
<% } %>
  </div>
  <button type="submit" name="action" value="password" class="btn">Sign in</button>
</form>
<form id="forgot" method="post" action="/login" hidden>
<%~ include('./_hidden', it) %>
  <input type="hidden" name="action" value="reset">
</form>
<div class="band">
  <form method="post" action="/login">
<%~ include('./_hidden', it) %>
    <input type="hidden" name="purpose" value="sign_in">
    <p>No password to hand? <button type="submit" name="action" value="send_code" class="link">Get a code by <%= it.codeChannel %></button></p>
  </form>
</div>
