<% layout('./layout') %>
<div class="intro">
<%~ include('./_logo', it) %>
  <h1 id="title">Password updated</h1>
</div>
<div class="form">
  <p class="text-block">You're all set. Use your new password next time you sign in to any app with <%= it.providerName %>.</p>
  <div class="actions">
    <a class="btn" href="<%= it.next %>">Continue to <%= it.clientName %></a>
  </div>
</div>
