<% layout('./layout') %>
<span class="badge"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
<h1 id="title">Password updated</h1>
<p class="lede">You're all set. Use your new password next time you sign in to any app with <%= it.providerName %>.</p>
<a class="btn" href="<%= it.next %>">Continue to <%= it.clientName %></a>
