# Copy to .env, or run scripts/dev-secrets.sh to generate one. Local values only:
# a deployment reads these from the managed secret store (SEC-7).
HYDRA_DB_PASSWORD=
HYDRA_SECRETS_SYSTEM=      # 32+ characters; encrypts the signing keys at rest. Rotate, never lose.
HYDRA_SECRETS_COOKIE=      # 32+ characters; signs Hydra's session and CSRF cookies
UNI_AUTH_SERVICE_SECRET=   # the uni-auth-service client's secret (client credentials)

# The identity database: identities, credentials, sessions, the auth journal. uni-auth's own;
# no product database holds a credential.
IDENTITY_DB_PASSWORD=
DATABASE_OWNER_URL=postgres://uni_auth_owner:<IDENTITY_DB_PASSWORD>@127.0.0.1:5434/identity  # migrations only
DATABASE_URL=postgres://uni_auth_api:uni_auth_api@127.0.0.1:5434/identity  # the app; local role from db:dev-roles

# The login application (src/config/env.ts).
COOKIE_SECRET=             # 32+ characters; signs the CSRF cookie
HYDRA_ADMIN_URL=http://127.0.0.1:4445
DEV_TEST_SUBJECT=dev-member  # part 3 only: signs anyone in as this subject; refused in production
# PORT=3100                # Hydra's urls.login/consent/logout point here
# PROVIDER_NAME=uni-auth
