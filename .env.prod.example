# A deployment's .env (docs/deploy.md). Copy to .env, fill in the first block, then
# scripts/prod-secrets.sh fills the secrets. Never committed.

# One command: `docker compose up --build -d` uses the production file.
COMPOSE_FILE=docker-compose.prod.yml

# Where uni-auth is served (nginx + TLS on the host), and the product it serves.
UNI_AUTH_HOST=uni-auth.gostyle.uk
GSN_WEB_ORIGIN=https://gsn.gostyle.uk
GSN_API_URL=https://gsn-api.gostyle.uk
PROVIDER_NAME=entity-auth

# Browser origins allowed to call entity-auth's token endpoint, comma separated. Unset, only
# GSN_WEB_ORIGIN. A local frontend also needs its /callback registered on the gsn-web client
# (deploy/hydra/clients.prod/gsn-web.json) before it can sign in.
CORS_ALLOWED_ORIGINS=https://gsn.gostyle.uk,http://localhost:3000

# Email codes (Resend's SMTP relay: the user is literally "resend", the password an API key).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Go Style Network <hello@thesarwar.site>"

# Phone numbers are refused until WhatsApp is set up (meta + WHATSAPP_* variables).
WHATSAPP_DELIVERY=off

# Optional: Sign in with Google (callback https://<UNI_AUTH_HOST>/upstream/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host ports nginx proxies to (127.0.0.1 only), and the compose network.
# HYDRA_PORT=4444
# LOGIN_PORT=3120   (host 3100 is taken by Loki on the VPS)
# UNI_AUTH_SUBNET=172.30.40.0/24

# Secrets: scripts/prod-secrets.sh. Keep a copy somewhere safe; losing HYDRA_SECRETS_SYSTEM
# loses the signing keys.
HYDRA_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
UNI_AUTH_DB_PASSWORD=
HYDRA_SECRETS_SYSTEM=
HYDRA_SECRETS_COOKIE=
HYDRA_HOOK_SECRET=
COOKIE_SECRET=
UNI_AUTH_SERVICE_SECRET=
